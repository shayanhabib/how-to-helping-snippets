<?php
//post type update.. 
add_action('init', function () {
    if (!function_exists('pll_set_post_language')) return;

    $default_lang = pll_default_language();
    $post_type = 'product'; // Replace with your CPT

    $args = [
        'post_type'      => $post_type,
        'posts_per_page' => -1,
        'post_status'    => 'any',
        'fields'         => 'ids',
    ];

    $posts = get_posts($args);

    foreach ($posts as $post_id) {
        // Only set language if it doesn't have one already
        if (!pll_get_post_language($post_id)) {
            pll_set_post_language($post_id, $default_lang);
        }
    }

    // Run only once, then comment out or remove this code
});


//taxonomy update..
add_action('init', function () {
    if (!function_exists('pll_set_term_language')) return;

    $default_lang = pll_default_language();
    $taxonomy = 'product_cat'; // Replace with your taxonomy slug

    $terms = get_terms([
        'taxonomy'   => $taxonomy,
        'hide_empty' => false,
    ]);

    foreach ($terms as $term) {
        // Only set language if it doesn't already have one
        if (!pll_get_term_language($term->term_id)) {
            pll_set_term_language($term->term_id, $default_lang);
        }
    }

    // Run only once, then comment out or remove this code
});
?>
