<?php
function deleteDirectory($dir) {
    if (!file_exists($dir)) {
        return true;
    }

    // Make sure it's a directory
    if (!is_dir($dir)) {
        return unlink($dir);
    }

    // Loop through files (including hidden)
    foreach (scandir($dir) as $item) {
        if ($item === '.' || $item === '..') {
            continue;
        }

        $path = $dir . DIRECTORY_SEPARATOR . $item;
        if (is_dir($path)) {
            deleteDirectory($path);
        } else {
            @unlink($path);
        }
    }

    return @rmdir($dir);
}

// Example usage:
$target = __DIR__.'/wp-content/plugins/testimonial-free';
//echo $target;
deleteDirectory($target);
