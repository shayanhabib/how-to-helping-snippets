<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>vCard Generator</title>

  <style>
  * {
    box-sizing: border-box;
    font-family: Arial;
  }
  h2 {
    text-align: center;
  }
  form {
    max-width: 500px;
    padding: 30px;
    background: #f7f7f7;
    margin: 0 auto;
  }
  label {
    display: block;
    margin: 10px 0;
    font-weight: bold;
    font-size: 14px;
  }
  label input {
    font-weight: normal;
    display: block;
    margin: 5px 0 0;
    padding: 10px;
    border-radius: 5px;
    width: 100%;
    border:1px solid #ccc;
  }
  label input:focus {
    border-color: #777;
  }
  button {
    font-weight: normal;
    background: #000;
    color: #fff;
    padding: 10px 20px;
    border-radius: 5px;
    border:none;
    margin: 10px 0 0;
  }
  </style>

</head>
<body>
  <h2>Create Your vCard</h2>
  <form id="vcardForm">
    <label>Photo: <input type="file" id="photo" accept="image/*"></label>
    <label>Full Name: <input type="text" id="fullName" required></label>
    <label>Email: <input type="email" id="email" required></label>
    <label>Phone: <input type="tel" id="phone"></label>
    <label>Address: <input type="text" id="address"></label>
    <label>Organization: <input type="text" id="organization"></label>
    <label>Job Title: <input type="text" id="jobTitle"></label>
    <label>Website: <input type="url" id="website"></label>
    <button type="submit">Download vCard</button>
  </form>

  <script>
  document.getElementById('vcardForm').addEventListener('submit', function(e) {
  e.preventDefault();

  const fullName = document.getElementById('fullName').value;
  const email = document.getElementById('email').value;
  const phone = document.getElementById('phone').value;
  const address = document.getElementById('address').value;
  const org = document.getElementById('organization').value;
  const jobTitle = document.getElementById('jobTitle').value;
  const website = document.getElementById('website').value;
  const photoFile = document.getElementById('photo').files[0];

  const [firstName, ...lastNameParts] = fullName.split(' ');
  const lastName = lastNameParts.join(' ');

  const generateVCard = (base64Image) => {
    const photoLine = base64Image ? `PHOTO;ENCODING=b;TYPE=JPEG:${base64Image}` : '';

    const vcard = `
BEGIN:VCARD
VERSION:3.0
FN:${fullName}
N:${lastName};${firstName};;;
EMAIL:${email}
TEL;TYPE=CELL:${phone}
ADR;TYPE=HOME:;;${address}
ORG:${org}
TITLE:${jobTitle}
URL:${website}
${photoLine}
END:VCARD
    `.trim();

    const blob = new Blob([vcard], { type: 'text/vcard' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${fullName.replace(/\s+/g, '_')}.vcf`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };

  if (photoFile) {
    const reader = new FileReader();
    reader.onload = function(event) {
      const base64String = event.target.result.split(',')[1]; // Remove data:image/jpeg;base64,
      generateVCard(base64String);
    };
    reader.readAsDataURL(photoFile);
  } else {
    generateVCard('');
  }
});
  </script>
</body>
</html>
