<?php
//no email field is required in checkout page.. 
add_filter('woocommerce_checkout_fields', function ($fields) {
    $fields['billing']['billing_email']['required'] = false;
    return $fields;
});

add_action('woocommerce_after_checkout_validation', function ($data, $errors) {
    if (empty($data['billing_email'])) {
        $errors->remove('billing_email');
    }
}, 10, 2);

add_filter('woocommerce_email_recipient_customer_processing_order', 'disable_emails_if_no_email', 10, 2);
add_filter('woocommerce_email_recipient_customer_completed_order', 'disable_emails_if_no_email', 10, 2);
add_filter('woocommerce_email_recipient_customer_on_hold_order', 'disable_emails_if_no_email', 10, 2);

function disable_emails_if_no_email($recipient, $order) {
    if (!$order || !is_a($order, 'WC_Order')) return $recipient;

    if (!$order->get_billing_email()) {
        return ''; // stop email
    }

    return $recipient;
}

add_filter('woocommerce_form_field_email', function ($field, $key, $args, $value) {
    $field = str_replace('&nbsp;<abbr class="required" title="required">*</abbr>', '', $field);
    return $field;
}, 10, 4);
